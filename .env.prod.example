# Copy to .env.prod and fill in every value. Never commit .env.prod.

# Your domain; its DNS A record must point at the server (Caddy gets the HTTPS certificate for it)
DOMAIN=pinpoint.example.com

# Random values, at least 32 characters each. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Comma-separated, real addresses you control that ALREADY have accounts (the moderator role)
MODERATOR_EMAILS=

ACCESS_TOKEN_EXPIRE_MINUTES=60
