# Backend address, including /api/v1. With it set, accounts, maps, places and photos use the real backend.
# Leave it out (or empty) for the browser-only demo that needs no backend.
VITE_API_URL=http://localhost:8000/api/v1

# Set to true to force the browser-only demo even when VITE_API_URL is set.
# VITE_USE_MOCKS=true
