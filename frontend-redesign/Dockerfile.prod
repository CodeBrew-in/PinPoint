# Production image: build the static site, then serve it with an unprivileged nginx.
# nginx also forwards /api and /media to the backend, so the browser talks to one address only.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# The API is reached through nginx on the same host. Without it the app would silently
# run the browser-only demo, so refuse to build.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN test -n "$VITE_API_URL" || (echo "VITE_API_URL must be set for a production build" && exit 1)
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
